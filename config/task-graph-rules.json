{
  "rules": [
    {
      "id": "douyin_holiday_conversion",
      "description": "抖音节日转化率提升方案",
      "match_any": ["抖音", "直播", "短视频", "五一", "节日", "营销", "活动", "促销", "投流", "千川", "引流"],
      "match_all_any": [
        ["转化率", "转化", "增长"],
        ["方案", "运营", "营销", "活动"]
      ],
      "nodes": [
        {
          "id": "data",
          "role": "data",
          "title": "数据诊断",
          "objective": "分析任务中的数据、指标、归因和约束：{{task}}"
        },
        {
          "id": "accounting",
          "role": "accounting",
          "title": "预算评估",
          "depends_on": ["data"],
          "objective": "基于上游数据诊断，评估活动成本、引流SKU、投流预算和经营风险。"
        },
        {
          "id": "creative",
          "role": "creative",
          "title": "创意产出",
          "depends_on": ["data"],
          "objective": "基于上游数据诊断，产出抖音短视频、直播或活动内容创意。"
        },
        {
          "id": "ops",
          "role": "ops",
          "title": "运营方案",
          "depends_on": ["accounting", "creative"],
          "objective": "整合财务和创意结果，形成可执行运营方案。"
        }
      ]
    }
  ]
}
